{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howismyip",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Custom entry: re-exports the TanStack Start handler + Durable Object classes.
  "main": "src/server-entry.ts",
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "howismyip.xyz", "custom_domain": true }],
  // Public deployment policy (not credentials). Keep secrets in Cloudflare.
  "vars": {
    "HOWISMYIP_DAILY_BUDGETS": "ripestat:100,proxycheck:900,abuseipdb:900,ipdata:1350,ipqs:900,scamalytics:4500,ipinfo:90,maxmind:300"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Per-provider daily quota counter; budgets come from the
  // HOWISMYIP_DAILY_BUDGETS table (unset = counter idle).
  "durable_objects": {
    "bindings": [{ "name": "PROVIDER_QUOTA", "class_name": "ProviderQuota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProviderQuota"] }]
}
