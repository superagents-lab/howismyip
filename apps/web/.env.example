# howismyip — provider configuration.
#
# Zero config needed: the six keyless sources run out of the box. Fill in any
# API keys below to unlock the corresponding paid/keyed sources — a keyed
# source activates automatically when its credentials are present.
#
# Advanced knobs (all optional, all off by default):
#   HOWISMYIP_DISABLED_PROVIDERS=geojs,ip2location     # turn sources off by id
#   HOWISMYIP_DAILY_BUDGETS=proxycheck:900,ipqs:900    # call caps, hosted only
#                                                       # (needs Cloudflare, see README)
#   HOWISMYIP_PROVIDER_TIMEOUT_MS=10000                # shared per-source timeout
#
# HOWISMYIP_DAILY_BUDGETS resets each provider on ITS OWN real billing cycle,
# not always daily: proxycheck/abuseipdb/ipdata are daily; ipqs/scamalytics/
# ipinfo reset monthly (their actual free-tier period); maxmind is a prepaid
# balance that never auto-resets — raise its number yourself after a top-up.

# proxycheck.io — adds a fraud/risk score. A free key raises the daily limit.
# https://proxycheck.io/dashboard/
PROXYCHECK_API_KEY=

# IPinfo Lite — free token, country + ASN attribution.
# https://ipinfo.io/account/token
IPINFO_TOKEN=

# Scamalytics — fraud score API (paid). Set BOTH the endpoint and the key.
# https://scamalytics.com/ip/api
SCAMALYTICS_API_URL=
SCAMALYTICS_API_KEY=

# AbuseIPDB — abuse confidence score + report count.
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# IPQualityScore — proxy/VPN/fraud detection.
# https://www.ipqualityscore.com/user/settings
IPQS_API_KEY=

# ipdata.co — threat block (proxy/Tor/datacenter/attacker) + asn.type (isp vs
# hosting vs business). Free tier ~1500/day.
# https://dashboard.ipdata.co/sign-up.html
IPDATA_API_KEY=

# MaxMind minFraud — official IP risk score. This is separate from GeoIP/
# GeoLite databases, which provide facts but no numeric IP risk score.
# https://dev.maxmind.com/minfraud/
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
