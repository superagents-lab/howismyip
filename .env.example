# howismyip — optional paid sources.
# The six keyless sources (ip-api, ipwho.is, RDAP, Team Cymru, Tor, DNSBL) work
# out of the box with NO configuration. The variables below unlock extra
# providers; a provider only activates when its key(s) are present.

# proxycheck.io — adds a fraud/risk score. A free key raises the daily limit.
# https://proxycheck.io/dashboard/
PROXYCHECK_API_KEY=

# IPinfo Lite — free token, country + ASN attribution.
# https://ipinfo.io/account/token
IPINFO_TOKEN=

# Scamalytics — fraud score API (paid). Set BOTH the endpoint and the key.
# https://scamalytics.com/ip/api
SCAMALYTICS_API_URL=
SCAMALYTICS_API_KEY=

# AbuseIPDB — abuse confidence score + report count.
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# IPQualityScore — proxy/VPN/fraud detection.
# https://www.ipqualityscore.com/user/settings
IPQS_API_KEY=

# ipdata.co — threat block (proxy/Tor/datacenter/attacker) + asn.type (isp vs
# hosting vs business). Free tier ~1500/day.
# https://dashboard.ipdata.co/sign-up.html
IPDATA_API_KEY=
