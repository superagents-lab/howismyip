# howismyip — provider configuration.
# Keyless providers are enabled by default. Keyed providers are also enabled by
# default, but only load when their required credentials are present.

# Shared per-provider timeout in milliseconds. Defaults to 10000.
HOWISMYIP_PROVIDER_TIMEOUT_MS=

# Per-provider switches. Empty means enabled; set to 0/false/no/off to disable.
# Provider ids are uppercased and non-alphanumeric characters become "_".
# Keyless providers:
HOWISMYIP_PROVIDER_IP_API_ENABLED=
HOWISMYIP_PROVIDER_GEOJS_ENABLED=
HOWISMYIP_PROVIDER_RDAP_ENABLED=
HOWISMYIP_PROVIDER_CYMRU_ENABLED=
HOWISMYIP_PROVIDER_IP2LOCATION_ENABLED=
HOWISMYIP_PROVIDER_IPAPI_IS_ENABLED=
HOWISMYIP_PROVIDER_TOR_ENABLED=
HOWISMYIP_PROVIDER_DNSBL_ENABLED=

# Keyed providers:
HOWISMYIP_PROVIDER_PROXYCHECK_ENABLED=
HOWISMYIP_PROVIDER_IPINFO_ENABLED=
HOWISMYIP_PROVIDER_SCAMALYTICS_ENABLED=
HOWISMYIP_PROVIDER_ABUSEIPDB_ENABLED=
HOWISMYIP_PROVIDER_IPQS_ENABLED=
HOWISMYIP_PROVIDER_IPDATA_ENABLED=
HOWISMYIP_PROVIDER_MAXMIND_ENABLED=

# proxycheck.io — adds a fraud/risk score. A free key raises the daily limit.
# https://proxycheck.io/dashboard/
PROXYCHECK_API_KEY=

# IPinfo Lite — free token, country + ASN attribution.
# https://ipinfo.io/account/token
IPINFO_TOKEN=

# Scamalytics — fraud score API (paid). Set BOTH the endpoint and the key.
# https://scamalytics.com/ip/api
SCAMALYTICS_API_URL=
SCAMALYTICS_API_KEY=

# AbuseIPDB — abuse confidence score + report count.
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# IPQualityScore — proxy/VPN/fraud detection.
# https://www.ipqualityscore.com/user/settings
IPQS_API_KEY=

# ipdata.co — threat block (proxy/Tor/datacenter/attacker) + asn.type (isp vs
# hosting vs business). Free tier ~1500/day.
# https://dashboard.ipdata.co/sign-up.html
IPDATA_API_KEY=

# MaxMind minFraud — official IP risk score. This is separate from GeoIP/
# GeoLite databases, which provide facts but no numeric IP risk score.
# https://dev.maxmind.com/minfraud/
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
