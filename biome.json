{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["ultracite"],
  "files": {
    "ignore": [
      "**/dist/**",
      "**/.output/**",
      "**/.tanstack/**",
      "**/.nitro/**",
      "**/routeTree.gen.ts",
      "apps/web/**"
    ]
  },
  "overrides": [
    {
      "include": ["packages/cli/**", "packages/core/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noConsoleLog": "off"
          }
        }
      }
    }
  ]
}
